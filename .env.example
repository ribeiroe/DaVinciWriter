# DaVinci Writer — Environment Configuration
# Copy this file to .env and fill in your API key.
# Never commit .env to version control.

# Required: Your Anthropic API key
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: main model for generation (default: claude-sonnet-5)
#ANTHROPIC_MODEL=claude-sonnet-5

# Optional: economy model for lightweight tasks (import, convert, quality check).
# Leave unset to use the main model for everything. Configurable in Settings.
#ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Optional: local / custom endpoint (cost-free local models).
# Point at any server that speaks the Anthropic Messages API — e.g. a LiteLLM
# proxy in front of Ollama. When set, the API key is not required and
# ANTHROPIC_MODEL should be the model ID your endpoint serves.
# Configurable in Settings -> Model & Costs -> Local / Custom Endpoint.
#ANTHROPIC_BASE_URL=http://localhost:4000
#ANTHROPIC_MODEL=ollama_chat/qwen2.5:14b
